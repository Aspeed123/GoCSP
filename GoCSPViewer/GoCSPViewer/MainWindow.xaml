<Window x:Class="GoCSPViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoCSP Viewer"
        Height="800"
        Width="1200">

    <DockPanel>

        <StackPanel
        Orientation="Horizontal"
        DockPanel.Dock="Top"
        Margin="5">

            <Button
            x:Name="RunButton"
            Content="Run"
            Width="100"
            Margin="5"
            Click="RunButton_Click"/>

            <Button
            x:Name="ModeButton"
            Content="Mode: Async"
            Width="160"
            Margin="5"
            Click="ModeButton_Click"/>

            <TextBlock
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Text="Speed"/>

            <Slider
            x:Name="SpeedSlider"
            Width="150"
            Minimum="0.25"
            Maximum="4"
            Value="1"
            TickFrequency="0.25"
            IsSnapToTickEnabled="True"
            Margin="0,8,0,0"
            ValueChanged="SpeedSlider_ValueChanged"/>

            <TextBlock
            x:Name="SpeedLabel"
            VerticalAlignment="Center"
            Margin="10,0,0,0"
            Text="1.0x"/>

        </StackPanel>

        <Grid x:Name="MainCanvas"/>

    </DockPanel>
</Window>